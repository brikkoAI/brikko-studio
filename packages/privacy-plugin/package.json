{
  "name": "@brikko/privacy-plugin",
  "version": "0.3.0",
  "private": true,
  "description": "Brikko privacy plugin for Studio Core — pipes OpenClaw hooks through the local Anonymizer sidecar.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
