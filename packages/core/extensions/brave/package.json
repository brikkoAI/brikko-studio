{
  "name": "@brikko-studio/brave-plugin",
  "version": "2026.5.3",
  "description": "Brikko Studio Brave plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/brikko-studio/brikko-studio"
  },
  "type": "module",
  "devDependencies": {
    "@brikko-studio/plugin-sdk": "workspace:*"
  },
  "brikko-studio": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@brikko-studio/brave-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.5.3"
    },
    "build": {
      "brikko-studioVersion": "2026.5.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
