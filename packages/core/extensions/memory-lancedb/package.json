{
  "name": "@brikko-studio/memory-lancedb",
  "version": "2026.5.3",
  "description": "Brikko Studio LanceDB-backed long-term memory plugin with auto-recall/capture",
  "repository": {
    "type": "git",
    "url": "https://github.com/brikko-studio/brikko-studio"
  },
  "type": "module",
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "openai": "^6.35.0",
    "typebox": "1.1.37"
  },
  "devDependencies": {
    "@brikko-studio/plugin-sdk": "workspace:*"
  },
  "brikko-studio": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@brikko-studio/memory-lancedb",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.5.3"
    },
    "build": {
      "brikko-studioVersion": "2026.5.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
