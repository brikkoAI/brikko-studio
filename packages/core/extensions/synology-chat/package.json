{
  "name": "@brikko-studio/synology-chat",
  "version": "2026.5.3",
  "description": "Synology Chat channel plugin for Brikko Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/brikko-studio/brikko-studio"
  },
  "type": "module",
  "dependencies": {
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@brikko-studio/plugin-sdk": "workspace:*"
  },
  "brikko-studio": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "synology-chat",
      "label": "Synology Chat",
      "selectionLabel": "Synology Chat (Webhook)",
      "docsPath": "/channels/synology-chat",
      "docsLabel": "synology-chat",
      "blurb": "Connect your Synology NAS Chat to Brikko Studio with full agent capabilities.",
      "order": 90
    },
    "install": {
      "npmSpec": "@brikko-studio/synology-chat",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.5.3"
    },
    "build": {
      "brikko-studioVersion": "2026.5.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
