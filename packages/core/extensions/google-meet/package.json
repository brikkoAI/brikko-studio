{
  "name": "@brikko-studio/google-meet",
  "version": "2026.5.3",
  "description": "Brikko Studio Google Meet participant plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/brikko-studio/brikko-studio"
  },
  "type": "module",
  "dependencies": {
    "commander": "^14.0.3",
    "typebox": "1.1.37"
  },
  "devDependencies": {
    "@brikko-studio/plugin-sdk": "workspace:*",
    "brikko-studio": "workspace:*"
  },
  "peerDependencies": {
    "brikko-studio": ">=2026.5.3"
  },
  "peerDependenciesMeta": {
    "brikko-studio": {
      "optional": true
    }
  },
  "brikko-studio": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@brikko-studio/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.5.3"
    },
    "build": {
      "brikko-studioVersion": "2026.5.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
